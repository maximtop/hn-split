{
  "manifest_version": 3,
  "name": "HN Split",
  "description": "Open the Hacker News discussion for the current article after an explicit click.",
  "version": "0.1.0",
  "minimum_chrome_version": "140",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://hn.algolia.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "HN Split",
    "default_popup": "index.html"
  }
}
