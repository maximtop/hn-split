{
  "name": "hn-split",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "locales:validate": "node scripts/validate-locales.mjs",
    "store:validate": "node scripts/validate-store-listings.mjs",
    "store:render": "node scripts/render-store-listing.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build chrome && playwright test --config=playwright.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm locales:validate && pnpm store:validate && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:e2e",
    "start": "pnpm build --watch",
    "package": "pnpm release"
  },
  "dependencies": {
    "@adguard/translate": "2.0.8",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "mobx": "7.0.0",
    "mobx-react-lite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldts": "7.4.10",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@rspack/cli": "2.1.7",
    "@rspack/core": "2.1.7",
    "@types/adm-zip": "^0.5.8",
    "@types/chrome": "0.2.5",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "adm-zip": "^0.6.0",
    "eslint": "10.11.0",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.10"
  }
}
